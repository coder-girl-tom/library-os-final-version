# library os - Configuration File
# Copy this file to .env and customize as needed

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# SQLite: sqlite:///library.db
# PostgreSQL: postgresql://user:password@localhost/librarydb
# MySQL: mysql+pymysql://user:password@localhost/librarydb
DATABASE_URL=sqlite:///library.db

# Application Settings
APP_NAME=library os
APP_VERSION=1.0
DEBUG=False

# Fine Configuration
FINE_AMOUNT_PER_DAY=5  # In PKR or your currency
DEFAULT_LOAN_DURATION=10  # In days
MAX_LOAN_DURATION=30  # In days

# Email Configuration (optional)
# For sending notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
DEFAULT_MAIL_SENDER=noreply@librarysystem.com

# Session Configuration
PERMANENT_SESSION_LIFETIME=3600  # In seconds
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True

# Server Configuration
HOST=0.0.0.0
PORT=5000
WORKERS=4

# Docker / Compose example (when using docker-compose.yml provided)
SECRET_KEY=change_this_secret
JWT_SECRET=change_this_jwt_secret
DATABASE_URL=postgresql://library:librarypass@db:5432/librarydb
BACKUP_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=1
REFRESH_TOKEN_EXPIRES=604800
PG_DUMP_PATH=pg_dump
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Scheduled backups
ENABLE_SCHEDULED_BACKUPS=1
# Hour and minute (24h) for daily backup (defaults to 02:00)
BACKUP_HOUR=2
BACKUP_MIN=0
# Retain backups (days). Old backups will be pruned from local disk.
BACKUP_RETENTION_DAYS=30

# Maximum number of backup files to keep per local store (instance and persistent).
# Set to 100000 for ~100k capacity per store.
BACKUP_MAX_FILES_PER_STORE=100000

# If set to 1, admin must provide an accession number when adding books.
# If 0, system will auto-generate accession numbers when omitted.
ADMIN_MANUAL_ACCESSION=0

# Persistent local backup folder (used to keep a copy outside the app instance directory so it survives reinstalls)
# If empty, defaults to user home: ~/.librarysystempro_backups
PERSISTENT_BACKUP_DIR=

# Initial admin (change immediately after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
